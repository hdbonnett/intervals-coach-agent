# Install as /etc/coach-agent/.env, then: chown root:coach .env && chmod 640 .env
# Values are read by systemd and by `coach-as`; keep them unquoted with no spaces.
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...

# Where the database lives (config.yaml reads this; defaults to ./data when unset).
COACH_DATA_DIR=/var/lib/coach-agent/data

# Stop the bundled Claude CLI making non-essential calls (update checks, telemetry).
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Uncomment if the VM reaches the internet through a proxy.
# HTTPS_PROXY=http://proxy.example.lan:3128
# NO_PROXY=localhost,127.0.0.1

# The Intervals.icu Connector uses OAuth; its tokens live in the service user's home, not here.
